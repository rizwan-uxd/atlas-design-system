      { "id": "alternate-path", "type": "match", "pattern": "different card|another card|contact support|support", "flags": "i" },
      { "id": "failure-announced", "type": "match", "pattern": "role=\"alert\"|aria-live|\\.focus\\(" },
      { "id": "timeout-distinct", "type": "match", "pattern": "time(d)? ?out|network|connection", "flags": "i" }
    ]
  }
