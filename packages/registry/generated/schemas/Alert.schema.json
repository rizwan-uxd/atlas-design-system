{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.design-system/schemas/registry/Alert.schema.json",
  "$comment": "GENERATED — do not hand-edit. registry-build from packages/registry/src/Alert.registry.json and the Alert facts; run npm run registry:build.",
  "title": "Alert protocol node",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "type": { "const": "Alert" },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant": {
          "enum": ["info", "success", "warning", "danger", "neutral"]
        },
        "size": {
          "enum": ["sm", "md", "lg"]
        },
        "dismissible": { "type": "boolean" },
        "hideIcon": { "type": "boolean" }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": { "type": "array" },
        "children": { "type": "array" },
        "description": { "type": "array" },
        "icon": { "type": "array" },
        "title": { "type": "array" }
      }
    }
  }
}
