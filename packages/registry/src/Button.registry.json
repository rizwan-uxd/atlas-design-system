{
  "_note": "AUTHORED. registryComplete stays false until the owner decides fallback, nesting, a11y and responsive (M3 plan, Global constraints).",
  "type": "Button",
  "aliasOf": "Button",
  "kind": "component",
  "platforms": ["web"],
  "registryComplete": false,
  "protocolProps": {
    "variant": {
      "values": ["primary", "secondary", "outline", "ghost", "destructive", "link"]
    },
    "size": {
      "values": ["xs", "sm", "md", "lg"]
    },
    "iconOnly": {},
    "loading": {},
    "disabled": {}
  },
  "hiddenProps": { "asChild": "Web-only Radix Slot composition: it styles a child element, which a protocol node cannot pass." },
  "events": {
    "click": { "handler": "onClick" }
  },
  "slots": ["children", "leadingIcon", "trailingIcon"],
  "states": {
    "default": "interaction",
    "hover": "interaction",
    "focus-visible": "interaction",
    "active": "interaction",
    "disabled": "prop",
    "loading": "prop"
  },
  "stateProps": { "disabled": "disabled", "loading": "loading" },
  "tokenRoles": {
    "destructive-background": "--atlas-button-destructive-background",
    "destructive-background-active": "--atlas-button-destructive-background-active",
    "destructive-background-hover": "--atlas-button-destructive-background-hover",
