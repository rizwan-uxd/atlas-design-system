    "foreground-disabled": "--atlas-button-foreground-disabled",
    "gap": "--atlas-button-gap",
    "ghost-background-active": "--atlas-button-ghost-background-active",
    "ghost-background-hover": "--atlas-button-ghost-background-hover",
    "ghost-foreground": "--atlas-button-ghost-foreground",
    "link-foreground": "--atlas-button-link-foreground",
    "link-foreground-active": "--atlas-button-link-foreground-active",
    "link-foreground-hover": "--atlas-button-link-foreground-hover",
    "outline-background-active": "--atlas-button-outline-background-active",
    "outline-background-hover": "--atlas-button-outline-background-hover",
    "outline-border": "--atlas-button-outline-border",
    "outline-foreground": "--atlas-button-outline-foreground",
    "primary-background": "--atlas-button-primary-background",
    "primary-background-active": "--atlas-button-primary-background-active",
    "primary-background-hover": "--atlas-button-primary-background-hover",
    "primary-foreground": "--atlas-button-primary-foreground",
    "radius": "--atlas-button-radius",
    "secondary-background": "--atlas-button-secondary-background",
    "secondary-background-active": "--atlas-button-secondary-background-active",
