{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.design-system/schemas/figma-pull.schema.json",
  "title": "The Figma pull file (.atlas-pull/pull.json)",
  "description": "Written by the atlas-figma-sync skill from Figma MCP calls and read once by scripts/atlas-sync.mjs --pull. Shape: .agents/skills/atlas-figma-sync/references/pull-file.md. `variables` is deliberately open while D1 decides how the token table is read.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fileKey",
    "pulledAt",
    "components"
  ],
  "properties": {
    "fileKey": {
      "$ref": "common.schema.json#/$defs/figmaFileKey"
    },
    "figmaVersion": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "pulledAt": {
      "$ref": "common.schema.json#/$defs/isoDate"
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/componentName"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "properties"
        ],
        "properties": {
          "nodeId": {
            "$ref": "common.schema.json#/$defs/figmaNodeId"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "properties": {
            "$ref": "common.schema.json#/$defs/figmaProperties"
          },
          "componentProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "description": "VARIANT entries are accepted and dropped by the generator: those axes are `properties`.",
                  "enum": [
                    "BOOLEAN",
                    "INSTANCE_SWAP",
                    "TEXT",
                    "VARIANT"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "variables": {
      "$ref": "#/$defs/variableTable"
    },
    "boundVariables": {
      "description": "D1 option C: variables bound to the pulled components, with their codeSyntax.WEB name. A subset, kept as a cross-check of the full table in `variables`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pulledAt",
        "figmaVersion",
        "entries"
      ],
      "properties": {
        "pulledAt": {
          "$ref": "common.schema.json#/$defs/isoDate"
        },
        "figmaVersion": {
          "$ref": "common.schema.json#/$defs/nullableText"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "collection",
              "type",
              "web"
            ],
            "properties": {
              "name": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "collection": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "type": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "web": {
                "$ref": "common.schema.json#/$defs/nullableText"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "variableTable": {
      "description": "D1 option B: the whole local variable table, read with figma.variables.getLocalVariablesAsync() through use_figma (read-only). Names, collections, modes and codeSyntax.WEB only; values are not pulled. Written to atlas/tokens.json figmaTable; the token values above it stay derived from atlas.tokens.css.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pulledAt",
        "figmaVersion",
        "collections",
        "entries"
      ],
      "properties": {
        "pulledAt": {
          "$ref": "common.schema.json#/$defs/isoDate"
        },
        "figmaVersion": {
          "$ref": "common.schema.json#/$defs/nullableText"
        },
        "collections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "modes",
              "count"
            ],
            "properties": {
              "name": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "modes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "common.schema.json#/$defs/text"
                }
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "collection",
              "type",
              "web"
            ],
            "properties": {
              "name": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "collection": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "type": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "web": {
                "$ref": "common.schema.json#/$defs/nullableText"
              }
            }
          },
          "minItems": 1
        }
      }
    }
  }
}
