{
  "name": "atlas-design-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next .turbo node_modules/.cache",
    "dev": "next dev --port 3030",
    "dev:fresh": "rm -rf .next .turbo && next dev --port 3030",
    "build": "next build",
    "start": "next start --port 3030",
    "lint": "eslint",
    "tokens:build": "node scripts/convert-tokens.mjs",
    "token-lint": "node packages/governance/token-lint.mjs",
    "atlas:sync": "node scripts/atlas-sync.mjs",
    "atlas:sync:check": "node scripts/atlas-sync.mjs --check",
    "atlas:verify": "node scripts/atlas-verify.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.5",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest-axe": "^8.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
